# Copy this file to ".env" and fill in real values. The .env file is
# git-ignored so keys are never committed.

# LLM endpoint pool. Entries separated by semicolons; fields within an entry
# are base_url|api_key|model:
#
#   LLM_ENDPOINTS=<base_url>|<api_key>|<model>;<base_url>|<api_key>|<model>
#
# Free-tier daily caps apply per provider AND per model, so listing several
# provider/model combinations multiplies the usable daily budget. The client
# works through the pool in order, disables an endpoint for the session when
# it reports a daily cap, and stops gracefully when all are exhausted.
#
# Example pool mixing Groq models (console.groq.com/keys) and Google Gemini
# (aistudio.google.com):
LLM_ENDPOINTS=https://api.groq.com/openai/v1|gsk_your_key|llama-3.3-70b-versatile;https://api.groq.com/openai/v1|gsk_your_key|openai/gpt-oss-120b;https://generativelanguage.googleapis.com/v1beta/openai/|your_gemini_key|gemini-2.5-flash

# Request timeout in seconds.
LLM_TIMEOUT=60

# SEC EDGAR fair-access policy requires a contact email in the request
# User-Agent header. Use your own email here.
SEC_EMAIL=your_email@example.com
SEC_COMPANY_NAME=RAG-Research-Project
